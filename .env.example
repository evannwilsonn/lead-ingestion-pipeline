# Copy to .env in this folder, fill in, then: chmod 600 .env
# Never commit .env (it's already in .gitignore).

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Airtable personal access token, scopes data.records:read + data.records:write
# (AIRTABLE_PAT is accepted as an alternative name)
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX     # the app... part of your base URL
# Table name or tbl... id (AIRTABLE_TABLE_NAME is accepted as an alternative name)
AIRTABLE_TABLE=Leads

# Relative paths are resolved from this folder. On a Linux server you can use
# an absolute path instead, e.g. /opt/lead-pipeline/secrets/token.json
GMAIL_TOKEN_FILE=token.json
GMAIL_CLIENT_SECRET_FILE=client_secret.json   # only needed for --authorize

# --- Optional: Tier 1 text alerts via Twilio --------------------------------
# Leave blank to turn alerts off. Numbers in E.164 format (+18135550142).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=        # (TWILIO_PHONE_NUMBER also works)
ALERT_TO_NUMBERS=          # comma-separated; MY_CELL_PHONE also works

# --- Optional tuning -------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-5-5
GMAIL_SUBJECT=New Website Inquiry
GMAIL_PROCESSED_LABEL=Lead-Processed
GMAIL_FAILED_LABEL=Lead-Failed
MAX_EMAILS_PER_RUN=50
TIER1_BUDGET_THRESHOLD=10000
LOG_LEVEL=INFO
