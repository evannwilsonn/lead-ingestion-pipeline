# Copy to .env, fill in, then: chmod 600 .env
ANTHROPIC_API_KEY=
AIRTABLE_API_KEY=            # Airtable personal access token (pat...)
AIRTABLE_BASE_ID=            # app... (from the base URL)
AIRTABLE_TABLE=Leads         # table name or tbl... id

GMAIL_TOKEN_FILE=/opt/lead-pipeline/secrets/token.json
GMAIL_CLIENT_SECRET_FILE=./client_secret.json   # only needed for --authorize

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
GMAIL_SUBJECT=New Website Inquiry
GMAIL_PROCESSED_LABEL=Lead-Processed
GMAIL_FAILED_LABEL=Lead-Failed
MAX_EMAILS_PER_RUN=50
TIER1_BUDGET_THRESHOLD=10000
LOG_LEVEL=INFO
